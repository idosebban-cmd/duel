VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

VITE_GOOGLE_MAPS_KEY=your_google_maps_js_api_key

# Sentry (client bundle — use Vite public env prefix)
# Create a Browser + Capacitor project at https://sentry.io and copy the DSN here.
VITE_SENTRY_DSN=

# Sentry source map upload (build-time only; not bundled into the app).
# Create an auth token at: Organization Settings → Developer Settings → Auth Tokens (scopes: project:releases, org:read).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
